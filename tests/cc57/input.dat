#! Relinearized EOM-CC2 (RELIN) on H2O. With omega_fixed set to the exact
#! eigenvalue, eliminating part of the doubles space is a mathematical identity,
#! so the excitation energy must come out independent of where the explicit /
#! eliminated boundary is drawn -- including the two extremes, no doubles
#! explicit at all and every double explicit. Any dependence on RELIN_CUTOFF
#! here is an implementation error, not an approximation. The energy compared
#! below is the one RELIN reports after completing the eigenvector, so this also
#! covers the post-processing path.

molecule h2o {
  0 1
  H
  O 1 0.9
  H 2 0.9 1 104.0
}

set {
  basis cc-pVDZ
  roots_per_irrep [0, 0, 1, 0]
}
set cceom {
  r_convergence 1e-7
  e_convergence 1e-9
}

# Unpartitioned reference: ordinary EOM-CC2.
energy('eom-cc2')
escf = variable('SCF TOTAL ENERGY')
ecc2 = variable('CC2 TOTAL ENERGY')
omega_ref = variable('CC2 ROOT 0 (IN B1) TOTAL ENERGY') - ecc2

compare_values(-76.021709732313, escf, 7, "SCF energy")                                   #TEST
compare_values(-76.222533277834, ecc2, 7, "CC2 energy")                                   #TEST
compare_values(0.318331019997, omega_ref, 7, "EOM-CC2 excitation energy, unpartitioned")  #TEST

# 0.05 leaves no doubles explicit (everything folded); 50.0 leaves them all
# explicit (nothing folded); 1.0 is a genuine mixture.
for cutoff in [0.05, 1.0, 50.0]:
    clean()
    set_options({'cceom__relin': True,
                 'cceom__relin_cutoff': cutoff,
                 'cceom__relin_omega_fixed': omega_ref})
    energy('eom-cc2')
    omega = variable('CC2 ROOT 0 (IN B1) TOTAL ENERGY') - variable('CC2 TOTAL ENERGY')
    compare_values(omega_ref, omega, 7, f"RELIN excitation energy, cutoff {cutoff}")      #TEST

    # Packing the explicit doubles into a buffer dimensioned by the active space
    # changes the order in which the subspace dots sum their elements, so the two
    # layouts agree to rounding (~1e-13 observed) rather than to the last bit;
    # they are exactly bitwise only when the active space is the whole doubles
    # space. A deviation far above rounding means an indexing or masking error,
    # which is what this checks for.
    clean()
    set_options({'cceom__relin': True,
                 'cceom__relin_cutoff': cutoff,
                 'cceom__relin_omega_fixed': omega_ref,
                 'cceom__relin_packed': True})
    energy('eom-cc2')
    omega_packed = variable(f'CC2 ROOT 0 (IN B1) TOTAL ENERGY') - variable('CC2 TOTAL ENERGY')
    compare_values(omega, omega_packed, 12, f"RELIN packed == unpacked, cutoff {cutoff}")  #TEST
    set_options({'cceom__relin_packed': False})

# The identity must also hold with frozen core, which changes which orbitals the
# active-space predicate sees: the correlated occupied space, and hence the
# per-irrep offsets the masking and the packed layout are built from, both shift.
clean()
set_options({'freeze_core': True,
             'cceom__relin': False,
             'cceom__relin_packed': False,
             'cceom__relin_omega_fixed': 0.0})
energy('eom-cc2')
# Reference taken from this run, like the all-electron one above, so the test
# states the identity rather than depending on a number from elsewhere.
omega_ref_fc = variable('CC2 ROOT 0 (IN B1) TOTAL ENERGY') - variable('CC2 TOTAL ENERGY')

for cutoff in [0.05, 1.0, 50.0]:
    for packed in [False, True]:
        clean()
        set_options({'freeze_core': True,
                     'cceom__relin': True,
                     'cceom__relin_cutoff': cutoff,
                     'cceom__relin_omega_fixed': omega_ref_fc,
                     'cceom__relin_packed': packed})
        energy('eom-cc2')
        omega_fc = variable('CC2 ROOT 0 (IN B1) TOTAL ENERGY') - variable('CC2 TOTAL ENERGY')
        tag = "packed" if packed else "unpacked"
        compare_values(omega_ref_fc, omega_fc, 7,
                       f"RELIN frozen core, {tag}, cutoff {cutoff}")                      #TEST
